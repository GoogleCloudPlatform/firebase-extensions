{
  "name": "firestore-genai-chatbot",
  "scripts": {
    "lint": "eslint \"src/**/*\"",
    "lint:fix": "eslint \"src/**/*\" --fix",
    "build": "tsc -p tsconfig.build.json",
    "build:watch": "tsc -p tsconfig.build.json --watch",
    "generate-readme": "firebase ext:info .. --markdown > ../README.md",
    "test": "jest --config jest.config.json --runInBand",
    "publish-from-main": "firebase ext:dev:upload googlecloud/firestore-genai-chatbot --repo=https://github.com/googlecloudplatform/firebase-extensions --root=firestore-genai-chatbot --ref=main --project pub-ext-gcloud"
  },
  "main": "lib/index.js",
  "dependencies": {
    "@genkit-ai/firebase": "^1.24.0",
    "@genkit-ai/google-genai": "^1.24.0",
    "@google-ai/generativelanguage": "^2.3.0",
    "@google-cloud/aiplatform": "^3.19.0",
    "@google-cloud/vertexai": "^1.1.0",
    "@google/generative-ai": "^0.1.1",
    "@types/jest": "^29.5.14",
    "firebase-admin": "^12.1.0",
    "firebase-functions": "^4.9.0",
    "genkit": "^1.24.0",
    "google-auth-library": "^9.0.0",
    "typescript": "^5.8.2"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.54.0",
    "@typescript-eslint/parser": "^8.54.0",
    "eslint": "^9.39.2",
    "eslint-config-google": "^0.14.0",
    "eslint-plugin-import": "^2.26.0",
    "firebase-functions-test": "^3.0.0",
    "google-gax": "^4.3.2",
    "jest": "^29.7.0",
    "node-gyp": "^12.2.0",
    "ts-jest": "^29.1.0",
    "ts-node": "^10.9.2"
  },
  "overrides": {
    "@opentelemetry/auto-instrumentations-node": "^0.78.0",
    "@opentelemetry/core": "^2.8.0",
    "@opentelemetry/sdk-node": "^0.217.0",
    "@opentelemetry/sdk-trace-base": "^2.8.0",
    "adm-zip": "^0.6.0",
    "fast-xml-parser": "^5.7.0",
    "protobufjs": "^7.6.5",
    "tar": "^7.5.16",
    "ts-deepmerge": "^8.0.0",
    "uuid": "^11.1.1",
    "websocket-driver": "^0.7.5"
  },
  "files": [
    "lib"
  ],
  "private": true
}
